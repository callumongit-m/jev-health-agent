# --- Jev, pick ONE of the two -------------------------------------------
# Same model either way. `auto` prefers TypeSafe, then OpenRouter, then the
# offline fake.

# 1. Direct from TypeSafe -- https://docs.typesafe.ai  (console is invite-only)
TYPESAFE_API_KEY=

# 2. Or via OpenRouter's Decisions API -- https://openrouter.ai/typesafe
#    Model typesafe/jev-latest, $0.042/M input, output free.
OPENROUTER_API_KEY=
# Only set this if the Decisions path moves; the backend probes both published
# variants automatically and remembers whichever answers.
# OPENROUTER_DECISIONS_URL=
# Pin a fixed version instead of the floating alias:
# OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# --- Who writes the report -----------------------------------------------
# data     (default) return findings plus a presentation contract and let the
#          calling model write it up. No LLM cost on our side.
# narrated write the report ourselves. Needs ANTHROPIC_API_KEY. Use when the
#          caller has no model of its own.
RESPONSE_MODE=data

# Only needed for RESPONSE_MODE=narrated.
ANTHROPIC_API_KEY=
# claude-haiku-4-5 (cheapest, supports web search) | claude-sonnet-5 | claude-opus-5
REASONING_MODEL=claude-haiku-4-5
# Anthropic's server-side web search. No separate provider or key needed.
# Billed per search on top of tokens; set to 0 to disable.
ENABLE_WEB_SEARCH=1

# --- NHS guidance (optional) ---------------------------------------------
# NHS Website Content API v2 -- free, register at digital.nhs.uk/developer.
# Covers Health A-Z (conditions) and Live Well (the lifestyle factors).
# 4,000 requests/hour; responses cached 30 days. Without it the curated
# NHS-sourced corpus is used instead.
#
# Two NHS platforms exist and both 401 on the other's key. The default is
# the current one (api.service.nhs.uk, header `apikey`). If your key came
# from the older portal, set NHS_API_BASE=https://api.nhs.uk and it will
# send `subscription-key` instead.
#
# Run `uv run python scripts/check_nhs.py` to see which your key works with.
NHS_API_KEY=
# NHS_API_BASE=https://api.service.nhs.uk/nhs-website-content

# --- Wearables -----------------------------------------------------------
# Apple Health needs no keys. The public URL is what the phone posts to, so
# set it once deployed -- it is baked into the sync link people are given.
PUBLIC_BASE_URL=http://localhost:9000

# --- Deployment ----------------------------------------------------------
# Bearer token for the public MCP endpoint. The container refuses to start
# without it. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# Terra is wired but its floor is ~$499/mo, so it stays dormant unless set.
TERRA_DEV_ID=
TERRA_API_KEY=
TERRA_WEBHOOK_SECRET=
